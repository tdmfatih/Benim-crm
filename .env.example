# 3AS TEKNOLOJİ CRM / ERP - Production Environment Variables
# Target Production Host: https://panel.3asteknoloji.com
# Copy this file to .env and adjust the values according to your environment.
# NEVER commit the real .env file or real secrets to git.

# -----------------------------------------------------------------------------
# 1. NODE & SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Options: production | development
NODE_ENV=production
# Application port (must match your reverse proxy upstream, default 3000)
PORT=3000
# Canonical public URL of your CRM/ERP panel (no trailing slash)
APP_URL=https://panel.3asteknoloji.com

# -----------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Set this to connect to your production PostgreSQL 14+ database.
# If omitted or unconnectable, the app uses resilient local JSON storage.
DATABASE_URL=postgresql://as3_admin:CHANGE_THIS_TO_A_SECURE_PASSWORD@127.0.0.1:5432/as3_crm_erp
# Set to 'true' if using managed cloud databases (Neon, Supabase, RDS, AWS) requiring SSL
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# -----------------------------------------------------------------------------
# Secret string used to sign JSON Web Tokens (min 32 random characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS

# -----------------------------------------------------------------------------
# 4. META WHATSAPP BUSINESS CLOUD API (OPTIONAL)
# -----------------------------------------------------------------------------
# Leave empty if you do not have Meta WhatsApp Business API credentials yet.
# The CRM functions fully without it; simulated send logs will be recorded safely.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=3as_webhook_verify_token_change_in_prod

# -----------------------------------------------------------------------------
# 5. TURKISH E-INVOICE / E-ARCHIVE INTEGRATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Leave empty if you do not have e-Fatura entegratör API credentials yet.
# The CRM functions fully without it; invoices will be stored and queued safely.
EINVOICE_PROVIDER=generic
EINVOICE_API_KEY=
EINVOICE_API_SECRET=
# Options: test | production
EINVOICE_ENVIRONMENT=test
# Set to 'false' in production when using live GİB / Integrator credentials
EINVOICE_SANDBOX=true

# -----------------------------------------------------------------------------
# 6. OPTIONAL ARTIFICIAL INTELLIGENCE (GEMINI API)
# -----------------------------------------------------------------------------
# Optional Gemini API key for smart offer summaries and automated customer responses
GEMINI_API_KEY=
